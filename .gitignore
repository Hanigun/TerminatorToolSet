!assets/UprisingMap Editor/
assets/UprisingMap Editor/*
!assets/UprisingMap Editor/global_map.webp
SWT Editor.exe
list.txt

# Пользовательские данные рядом с программой (бэкапы карт, кастом-пресеты,
